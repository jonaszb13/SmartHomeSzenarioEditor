<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smarthome.controller.RaumController"
      AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
      AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
        <Label text="Raumübersicht" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Neuen Raum anlegen" onAction="#onNeuenRaumAnlegen"/>
        <Button text="Auswahl löschen" onAction="#onAuswahlLoeschen"
                style="-fx-background-color: #cc0000; -fx-text-fill: white;"/>
    </HBox>

    <Separator/>

    <ListView fx:id="raumListView" VBox.vgrow="ALWAYS"/>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.BearbeitenSzenarioController"
            AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

    <top>
        <VBox spacing="5" style="-fx-border-color: transparent transparent #c4c6c9 transparent; -fx-border-width: 0 0 1 0">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <HBox>
                <Label text="Bearbeitungsmodus" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Szenario löschen" prefHeight="30"
                        style="-fx-background-color: #cc0000; -fx-text-fill: white;"
                        onAction="#handleLoeschen"/>
            </HBox>
            <Label fx:id="szenarioNameKopf" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12" style="-fx-background-color: #fff">
            <padding><Insets top="12" right="10" bottom="10" left="10"/></padding>

            <VBox spacing="4">
                <Label text="Szenarioname"/>
                <TextField fx:id="nameField" prefWidth="400"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Kurzbeschreibung"/>
                <TextArea fx:id="beschreibungField" prefHeight="80" wrapText="true"/>
            </VBox>

            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <Label text="Aktionsfolge"/>
                <HBox spacing="10" VBox.vgrow="ALWAYS">
                    <ListView fx:id="aktionenListView" HBox.hgrow="ALWAYS" prefHeight="200"/>
                    <VBox spacing="8">
                        <Button text="Aktion hinzufügen" prefWidth="180" onAction="#handleAktionHinzufuegen"/>
                        <Button text="Aktion bearbeiten" prefWidth="180" onAction="#handleAktionBearbeiten"/>
                        <Button text="Aktion löschen"    prefWidth="180" onAction="#handleAktionLoeschen"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-background-color: #fff">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Button text="Abbrechen"           prefWidth="200" prefHeight="50" onAction="#handleAbbrechen"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Änderungen speichern" prefWidth="200" prefHeight="50" onAction="#handleSpeichern"/>
        </HBox>
    </bottom>

</BorderPane>

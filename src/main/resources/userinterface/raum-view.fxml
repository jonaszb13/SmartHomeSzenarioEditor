<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.RaumController"
            AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

    <top>
        <VBox spacing="5" style="-fx-border-color: transparent transparent #c4c6c9 transparent; -fx-border-width: 0 0 1 0">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <VBox>
                <Label text="Einzelansicht" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Label fx:id="raumNameLabel" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            </VBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="16" style="-fx-background-color: #fff">
            <padding><Insets top="16" right="10" bottom="10" left="10"/></padding>

            <VBox spacing="4">
                <Label text="Raumname"/>
                <TextField fx:id="raumNameField" editable="false" prefWidth="300"
                           style="-fx-background-color: #f0f0f0;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Zugewiesene Geräte"/>
                <ListView fx:id="geraeteListView" prefHeight="150" prefWidth="300"
                          style="-fx-background-color: #f0f0f0;" mouseTransparent="true" focusTraversable="false"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox style="-fx-background-color: #fff">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Button text="Schließen" prefWidth="200" prefHeight="50" onAction="#handleSchliessen"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Bearbeiten" prefWidth="200" prefHeight="50" onAction="#handleBearbeiten"/>
        </HBox>
    </bottom>

</BorderPane>
